---
import Button from './Button.astro';
import StatStrip from './StatStrip.astro';
import HiveArt from './art/HiveArt.astro';

interface Stat {
  value: string;
  unit: string;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  emphasis: string;
  lead: string;
  primaryCtaHref: string;
  primaryCtaLabel: string;
  secondaryCtaHref: string;
  secondaryCtaLabel: string;
  finePrint: string;
  stats: Stat[];
}

const {
  eyebrow,
  title,
  emphasis,
  lead,
  primaryCtaHref,
  primaryCtaLabel,
  secondaryCtaHref,
  secondaryCtaLabel,
  finePrint,
  stats,
} = Astro.props;
---

<div class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="fw-eyebrow">{eyebrow}</div>
      <h1>{title} <em>{emphasis}</em></h1>
      <p class="lead">{lead}</p>
      <div class="cta-row">
        <Button href={primaryCtaHref} variant="primary">{primaryCtaLabel}</Button>
        <Button href={secondaryCtaHref} variant="ghost">{secondaryCtaLabel}</Button>
      </div>
      <p class="fine">{finePrint}</p>
    </div>
    <div class="hero-art">
      <HiveArt />
    </div>
  </div>
  <div class="wrap">
    <StatStrip stats={stats} />
  </div>
</div>
