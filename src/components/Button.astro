---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
  style?: string;
  [attr: string]: unknown;
}

const { href, variant = 'primary', class: className, style, ...attrs } = Astro.props;
---

<a href={href} class={['fw-btn', `fw-btn-${variant}`, className].filter(Boolean).join(' ')} style={style} {...attrs}>
  <slot />
</a>
