---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;
---

<div class:list={['sec-head', align === 'left' && 'left']}>
  {eyebrow && <p class="sec-eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="sec-desc">{description}</p>}
</div>
