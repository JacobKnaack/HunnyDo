---
// One numbered honeycomb from the "how it works" route (RouteArt.astro), standalone:
// no dotted path and no bee, so it fits above a step's text at phone width.
// Each piece loops on its own short timeline (the bee isn't there to cue the honey fill),
// and svg-motion.ts only plays it while it is on screen. All four share data-sync="steps" so
// they start, loop and stop on one shared clock instead of each starting when it scrolls in.
interface Props {
  step: 1 | 2 | 3 | 4;
  class?: string;
}
const { step, class: className } = Astro.props;

const labels = {
  1: "Step 1: a contact is added",
  2: "Step 2: tasks are assigned",
  3: "Step 3: a bell rings a reminder",
  4: "Step 4: a checkmark and a burst of honey",
};

// Same easing as RouteArt, used for every keyframe segment below.
const ease = "0.4 0 0.2 1";
const splines = (n: number) => Array(n).fill(ease).join(";");

// particles that burst out of hex 4 when the check lands
const burst = [
  { x: 79.67, y: 46, fill: "#FFC145" },
  { x: 0, y: 92, fill: "var(--fw-secondary)" },
  { x: -79.67, y: 46, fill: "#FFC145" },
  { x: -79.67, y: -46, fill: "var(--fw-secondary)" },
  { x: 0, y: -92, fill: "#FFC145" },
  { x: 79.67, y: -46, fill: "var(--fw-secondary)" },
];
---
<svg data-art data-sync="steps" data-still="2.5" class={className} viewBox="0 0 240 240" width="100%" style="display:block;width:100%;height:auto" role="img" aria-label={labels[step]}>
<path d="M120,68 L165.03,94 L165.03,146 L120,172 L74.97,146 L74.97,94 Z" fill="var(--fw-surface)" stroke="var(--fw-bg-dim)" stroke-width="3" stroke-linejoin="round"></path>
<g transform="translate(120,120)"><g><animateTransform attributeName="transform" type="scale" dur="6s" repeatCount="indefinite" values="0 0;0 0;1.12 1.12;1 1;1 1;0 0;0 0" keyTimes="0;0.05;0.1;0.1333;0.8333;0.9;1" calcMode="spline" keySplines={splines(6)}></animateTransform><path d="M0,-44 L38.11,-22 L38.11,22 L0,44 L-38.11,22 L-38.11,-22 Z" fill="#FFC145" stroke="#FFC145" stroke-width="13" stroke-linejoin="round"></path></g></g>
{step === 1 && (
<g transform="translate(120,120)"><circle cx="0" cy="-8" r="9" fill="none" stroke="#1F2430" stroke-width="3.5"></circle><path d="M-16,16 Q-16,3 0,3 Q16,3 16,16" fill="none" stroke="#1F2430" stroke-width="3.5" stroke-linecap="round"></path></g>
)}
{step === 2 && (
<g transform="translate(120,120)"><path d="M-15,-10 H15 M-15,0 H9 M-15,10 H12" stroke="#1F2430" stroke-width="3.5" stroke-linecap="round"></path></g>
)}
{step === 3 && (
<g transform="translate(120,120)"><path d="M-12,8 C-12,-3 -9,-14 0,-14 C9,-14 12,-3 12,8 L15,12 L-15,12 Z" fill="none" stroke="#1F2430" stroke-width="3.5" stroke-linejoin="round"></path><circle cx="0" cy="17" r="3" fill="#1F2430"></circle></g>
)}
{step === 4 && (
<g transform="translate(120,120)"><path d="M-16.67,1.67 L-5,13.33 L20,-15" fill="none" stroke="#1F2430" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"></path></g>
)}
<circle cx="160" cy="156" r="13" fill="#1F2430" stroke="var(--fw-surface)" stroke-width="3"></circle><text x="160" y="160.5" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="12.5" font-weight="800" fill="#FFFFFF">{step}</text>
{step === 3 && (
<>
<circle cx="120" cy="120" r="56" fill="none" stroke="#3E8FD0" stroke-width="3" opacity="0"><animate attributeName="r" dur="6s" repeatCount="indefinite" values="56;56;100;100" keyTimes="0;0.1333;0.3;1" calcMode="linear"></animate><animate attributeName="opacity" dur="6s" repeatCount="indefinite" values="0;0;0.7;0;0" keyTimes="0;0.1333;0.1351;0.3;1" calcMode="linear"></animate></circle>
<circle cx="120" cy="120" r="56" fill="none" stroke="#3E8FD0" stroke-width="3" opacity="0"><animate attributeName="r" dur="6s" repeatCount="indefinite" values="56;56;100;100" keyTimes="0;0.1833;0.35;1" calcMode="linear"></animate><animate attributeName="opacity" dur="6s" repeatCount="indefinite" values="0;0;0.7;0;0" keyTimes="0;0.1833;0.1851;0.35;1" calcMode="linear"></animate></circle>
</>
)}
{step === 4 && burst.map((p) => (
<g transform="translate(120,120)"><g><animateTransform attributeName="transform" type="translate" dur="6s" repeatCount="indefinite" values={`0 0;0 0;${p.x} ${p.y};${p.x} ${p.y}`} keyTimes="0;0.1333;0.2667;1" calcMode="spline" keySplines={splines(3)}></animateTransform><animate attributeName="opacity" dur="6s" repeatCount="indefinite" values="0;0;1;0;0" keyTimes="0;0.1333;0.1383;0.2667;1" calcMode="spline" keySplines={splines(4)}></animate><path d="M0,-7 L6.06,-3.5 L6.06,3.5 L0,7 L-6.06,3.5 L-6.06,-3.5 Z" fill={p.fill} stroke={p.fill} stroke-width="3" stroke-linejoin="round"></path></g></g>
))}
</svg>
