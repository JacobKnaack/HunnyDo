---
import type { ImageMetadata } from 'astro';
import HexCover from './HexCover.astro';
import CategoryTag from './CategoryTag.astro';
import { avatarInitials, type Category } from '../lib/blog';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  author: string;
  category: Category;
  coverImage?: ImageMetadata;
}

const { slug, title, description, date, author, category, coverImage } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<a class="featured-card" href={`/blog/${slug}.html`} data-cat={category}>
  <div class="featured-cover">
    <HexCover slug={slug} category={category} coverImage={coverImage} alt="" />
  </div>
  <div class="featured-body">
    <CategoryTag category={category} />
    <h2>{title}</h2>
    <p class="excerpt">{description}</p>
    <div class="post-meta">
      <div class="avatar">{avatarInitials(author)}</div>
      <span class="who">{author}</span>
      <span class="sep">&middot;</span>
      <span class="when">{formattedDate}</span>
    </div>
    <span class="read-more">
      Read the article
      <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</a>
