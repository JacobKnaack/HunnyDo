---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { seedFromSlug, CATEGORY_META, type Category } from '../lib/blog';

interface Props {
  slug: string;
  category: Category;
  coverImage?: ImageMetadata;
  alt?: string;
}

const { slug, category, coverImage, alt = '' } = Astro.props;
const seed = seedFromSlug(slug);
const accent = CATEGORY_META[category].accent;
---

{coverImage ? (
  <Image src={coverImage} alt={alt} loading="lazy" />
) : (
  <div class="hexcover" data-seed={seed} data-accent={accent}></div>
)}

<script>
  /* Procedural honeycomb cover art, echoes the logo mark. Deterministic per post
     via a seed derived from the slug, so the same post always gets the same art. */
  function seededRandom(seed) {
    let s = seed % 2147483647;
    if (s <= 0) s += 2147483646;
    return function () {
      s = (s * 16807) % 2147483647;
      return (s - 1) / 2147483646;
    };
  }

  function hexPoints(cx, cy, R) {
    const pts = [];
    for (let i = 0; i < 6; i++) {
      const a = (Math.PI / 180) * (60 * i - 90);
      pts.push((cx + R * Math.cos(a)).toFixed(1) + ',' + (cy + R * Math.sin(a)).toFixed(1));
    }
    return pts.join(' L ');
  }

  function renderHexCover(el) {
    const seed = Number(el.dataset.seed) || 1;
    const accent = el.dataset.accent || 'var(--marigold)';
    const rng = seededRandom(seed);
    const R = 25, cols = 8, rows = 5;
    const hspace = Math.sqrt(3) * R, vspace = 1.5 * R;
    const w = hspace * cols + hspace * 0.7;
    const h = vspace * rows + R * 1.6;
    const palette = ['var(--white)', 'var(--cloud-dim)', 'var(--white)', 'var(--cloud-dim)'];
    const checkedIdx = Math.floor(rng() * cols * rows);
    let idx = 0, out = '';
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = R * 0.9 + c * hspace + (r % 2 ? hspace / 2 : 0);
        const y = R * 1.1 + r * vspace;
        const isAccent = rng() < 0.14;
        const isCheck = idx === checkedIdx;
        const fill = isCheck ? accent : isAccent ? accent : palette[Math.floor(rng() * palette.length)];
        const opacity = isCheck || isAccent ? 1 : 0.55 + rng() * 0.45;
        const rr = R * 0.87;
        out += `<path d="M ${hexPoints(x, y, rr)} Z" fill="${fill}" opacity="${opacity}"/>`;
        if (isCheck) {
          out += `<path d="M${x - rr * 0.35},${y} L${x - rr * 0.06},${y + rr * 0.32} L${x + rr * 0.4},${y - rr * 0.34}" fill="none" stroke="var(--ink)" stroke-width="${(rr * 0.16).toFixed(1)}" stroke-linecap="round" stroke-linejoin="round"/>`;
        }
        idx++;
      }
    }
    el.innerHTML = `<svg viewBox="0 0 ${w.toFixed(0)} ${h.toFixed(0)}" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">${out}</svg>`;
  }

  document.querySelectorAll('.hexcover').forEach(renderHexCover);
</script>
