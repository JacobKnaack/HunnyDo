<button class="fw-nav-btn" data-fw-theme-toggle aria-label="Toggle dark theme"
        data-fw-theme-icon-light="moon" data-fw-theme-icon-dark="sun"></button>

<script>
  function syncGiscusTheme(theme: 'light' | 'dark') {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!iframe?.contentWindow) return;
    const url = `${location.origin}/assets/css/giscus-theme-${theme}.css`;
    iframe.contentWindow.postMessage(
      { giscus: { setConfig: { theme: url } } },
      'https://giscus.app',
    );
  }

  document.addEventListener('fw:themechange', (e: Event) => {
    syncGiscusTheme((e as CustomEvent<'light' | 'dark'>).detail);
  });
</script>
