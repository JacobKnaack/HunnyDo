---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="feature-card">
  <div class="feature-icon"><span class="fw-icon" data-fw-icon={icon} aria-hidden="true"></span></div>
  <h3>{title}</h3>
  <p>{description}</p>
</div>
