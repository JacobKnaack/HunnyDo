---
import BaseLayout from '../layouts/BaseLayout.astro';
import KitSectionHeading from '../components/KitSectionHeading.astro';
import Swatch from '../components/Swatch.astro';
import IconTile from '../components/IconTile.astro';
import DoDontCard from '../components/DoDontCard.astro';
import Footer from '../components/Footer.astro';
import '../styles/brand-kit.css';

const hexPath = 'M60,12 L101.57,36 L101.57,84 L60,108 L18.43,84 L18.43,36 Z';
const checkPath = 'M40,62 L54,76 L84,42';
---

<BaseLayout title="HunnyDo — Brand Kit" description="The HunnyDo identity — logomark, wordmark, color palette, and icon system, built directly from the product's design tokens.">
<div class="kit-wrap">

  <div class="intro">
    <div class="eyebrow">Brand Kit · v1.0</div>
    <h1>HunnyDo identity</h1>
    <p class="lede">The mark is a honeycomb cell with a task checked off inside it — every completed step fills in a cell in the comb. It's built directly from tokens already live in the product (Marigold, Plum, the squircle radius scale, the same checkmark path used on every checkbox), so the logo reads as the app, not a sticker on top of it.</p>
  </div>

  <!-- LOGOMARK -->
  <section>
    <KitSectionHeading title="Logomark" num="01" />
    <p class="sec-note">One hexagon, one checkmark. The corner-rounding matches the app's squircle system exactly (a round stroke join at 14 units on a 120 unit cell — the same relationship as a card's 24px radius on its container). Nothing about the mark is arbitrary: it's a cell from the comb, mid-completion.</p>
    <div class="stage-grid">
      <div class="stage stage-light">
        <svg width="88" height="88" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="stage-label">Primary — Marigold on white</span>
      </div>
      <div class="stage stage-plum">
        <svg width="88" height="88" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="stage-label">Primary — on Plum</span>
      </div>
      <div class="stage stage-cloud">
        <svg width="88" height="88" viewBox="0 0 120 120"><path d={hexPath} fill="#6B54A3" stroke="#6B54A3" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#F2F1EA" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="stage-label">Reverse — Plum on Cloud, for busy photography</span>
      </div>
      <div class="stage stage-ink">
        <svg width="88" height="88" viewBox="0 0 120 120"><path d={hexPath} fill="none" stroke="#F2F1EA" stroke-width="8" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#F2F1EA" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="stage-label">Monochrome — single color, stamps &amp; print</span>
      </div>
    </div>
  </section>

  <!-- WORDMARK / LOCKUPS -->
  <section>
    <KitSectionHeading title="Wordmark &amp; lockups" num="02" />
    <p class="sec-note">Set in Plus Jakarta Sans 800, same face and weight as every H1 in the product. "Hunny" stays Ink so the name reads first; "Do" takes Marigold-dk so the mark's color continues into the type instead of sitting apart from it.</p>
    <div class="stage-grid">
      <div class="stage stage-light">
        <div class="lockup-h">
          <svg width="46" height="46" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="word"><span class="a">Hunny</span><span class="b">Do</span></span>
        </div>
        <span class="stage-label">Horizontal — nav bars, headers, letterhead</span>
      </div>
      <div class="stage stage-plum">
        <div class="lockup-h">
          <svg width="46" height="46" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="word"><span class="a">Hunny</span><span class="b">Do</span></span>
        </div>
        <span class="stage-label">Horizontal — on Plum</span>
      </div>
      <div class="stage stage-light">
        <div class="lockup-stacked">
          <svg width="52" height="52" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="word"><span class="a">Hunny</span><span class="b">Do</span></span>
        </div>
        <span class="stage-label">Stacked — social avatars, app store, square placements</span>
      </div>
      <div class="stage stage-cloud">
        <div style="display:flex; flex-direction:column; align-items:center; gap:var(--sp-4)">
          <div class="clearspace-demo">
            <span class="tick top">x</span>
            <span class="tick left">x</span>
            <svg width="60" height="60" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
        </div>
        <span class="stage-label">Clearspace = x, where x is the hex's own width. Nothing else sits inside that margin.</span>
      </div>
    </div>
  </section>

  <!-- MINIMUM SIZE -->
  <section>
    <KitSectionHeading title="Minimum size" num="03" />
    <p class="sec-note">Below 20px the checkmark stroke starts to close up and read as a solid triangle rather than a check. At that scale, drop to the plain hex (no checkmark) — that's what the favicon and browser tab already do.</p>
    <div class="card">
      <div class="size-row">
        <div class="size-demo"><svg width="64" height="64" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="lbl">64px — app icon</span></div>
        <div class="size-demo"><svg width="32" height="32" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="lbl">32px — favicon, floor for the checkmark</span></div>
        <div class="size-demo"><svg width="20" height="20" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /></svg><span class="lbl">20px — plain hex, no check</span></div>
        <div class="size-demo"><svg width="14" height="14" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /></svg><span class="lbl">14px — nav dot, browser tab</span></div>
      </div>
    </div>
  </section>

  <!-- DO / DONT -->
  <section>
    <KitSectionHeading title="Usage" num="04" />
    <div class="dd-grid">
      <DoDontCard variant="do" description="Keep the hex on a solid, high-contrast field — white, Cloud, Plum, or Ink.">
        <svg width="60" height="60" viewBox="0 0 120 120"><path d={hexPath} fill="#FFC145" stroke="#FFC145" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#1F2430" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </DoDontCard>
      <DoDontCard variant="dont" description="Don't rotate it, recolor the hex to a status color, or swap the checkmark for another icon.">
        <svg width="60" height="60" viewBox="0 0 120 120" style="transform:rotate(24deg)"><path d={hexPath} fill="#3E8FD0" stroke="#3E8FD0" stroke-width="14" stroke-linejoin="round" /><path d={checkPath} fill="none" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </DoDontCard>
    </div>
  </section>

  <!-- COLOR -->
  <section>
    <KitSectionHeading title="Brand palette" num="05" />
    <p class="sec-note">Pulled straight from the product's design tokens — the brand never has a different palette than the app it represents.</p>
    <div class="swatch-grid">
      <Swatch name="Marigold" hex="#FFC145" use="Mark, primary CTA" />
      <Swatch name="Marigold Dark" hex="#E8A521" use={'"Do" wordmark accent'} />
      <Swatch name="Plum" hex="#4C3A73" use="Nav, email header" />
      <Swatch name="Ink" hex="#1F2430" use="Wordmark, checkmark" />
      <Swatch name="Cloud" hex="#F5F6F1" use="Backgrounds" chipStyle="background:#F5F6F1; border-bottom:1.5px solid var(--cloud-dim)" />
      <Swatch name="Meadow" hex="#3FA672" use="Task completed" />
    </div>
  </section>

  <!-- ICON SYSTEM -->
  <section>
    <KitSectionHeading title="Icon system" num="06" />
    <p class="sec-note">Every product icon is outline-only: 16–20px box, 1.3–1.4px stroke, round caps and joins, currentColor. No fills except the one place a filled icon is meaningful — a checkmark on a completed item. These three already exist in the app (item-type pills); this is them formalized as a set.</p>
    <div class="icon-grid">
      <IconTile name="Upload" use="File requested from client">
        <svg viewBox="0 0 16 16" fill="none"><path d="M8 11V3M8 3L5 6M8 3l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /><path d="M3 11v1.5a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
      </IconTile>
      <IconTile name="Answer" use="Text/URL/email requested">
        <svg viewBox="0 0 16 16" fill="none"><path d="M3 4h10M3 8h7M3 12h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
      </IconTile>
      <IconTile name="Check off" use="One-tap confirmation">
        <svg viewBox="0 0 16 16" fill="none"><rect x="3" y="3" width="10" height="10" rx="2.5" stroke="currentColor" stroke-width="1.4" /><path d="M5.5 8l1.6 1.6L11 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </IconTile>
      <IconTile name="Action needed" use="Overdue / awaiting action">
        <svg viewBox="0 0 16 16" fill="none"><path d="M8 5v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="8" cy="10.7" r="0.8" fill="currentColor" /><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" /></svg>
      </IconTile>
      <IconTile name="Completed" use="The one filled-background exception" wrapStyle="background:var(--meadow-bg); color:var(--meadow)">
        <svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.2 11.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </IconTile>
    </div>
  </section>

  <!-- FAVICON / APP ICONS -->
  <section>
    <KitSectionHeading title="Favicon &amp; app icons" num="07" />
    <p class="sec-note">Existing exports, shown at native size, plus the sizes still worth generating from <code>logo-mark.svg</code> as the source file.</p>
    <div class="card" style="margin-bottom:var(--sp-4)">
      <div class="fav-row">
        <div class="fav-demo"><img src="/appletouchicon.png" width="76" height="76" alt="Apple touch icon"><span class="lbl">appletouchicon.png</span></div>
        <div class="fav-demo"><img src="/favicon32x32.png" width="32" height="32" alt="Favicon"><span class="lbl">favicon32x32.png</span></div>
      </div>
    </div>
    <div class="card">
      <table class="spec">
        <thead><tr><th>Size</th><th>File</th><th>Use</th></tr></thead>
        <tbody>
          <tr><td>16×16, 32×32</td><td class="file">favicon.ico</td><td>Browser tab</td></tr>
          <tr><td>180×180</td><td class="file">apple-touch-icon.png</td><td>iOS home screen</td></tr>
          <tr><td>192×192, 512×512</td><td class="file">android-chrome-*.png</td><td>PWA / Android home screen</td></tr>
          <tr><td>1200×630</td><td class="file">og-image.png</td><td>Link preview — lockup on Plum, centered</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ASSETS -->
  <section>
    <KitSectionHeading title="Source files in this kit" num="08" />
    <dl class="kv">
      <dt>logo-mark.svg</dt><dd>Primary marigold hex + ink checkmark, transparent background.</dd>
      <dt>logo-mark-reverse.svg</dt><dd>Plum hex + cloud checkmark, for dark or photographic backgrounds.</dd>
      <dt>logo-mark-mono.svg</dt><dd>Single-color outline, for stamps, embossing, and print that can't hold two colors.</dd>
      <dt>logo-lockup-horizontal.svg</dt><dd>Mark + wordmark, vector, for headers and letterhead.</dd>
    </dl>
  </section>

  <p class="kit-note">HunnyDo Brand Kit v1.0 — built on the same tokens as the product design system. Marigold, Plum, and the squircle radius scale are the single source of truth; this file just applies them to the mark.</p>

</div>
<Footer />
</BaseLayout>
